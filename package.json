{
  "name": "orbitfit",
  "private": true,
  "version": "0.1.0",
  "description": "OrbitFit: exercise-based astronaut health self-monitoring. Offline-first static web app (NASA Space Apps Challenge 2026).",
  "author": "Syed Hassaan Areeb Kazmi, Eman Fatima, Mohammad Bin Javed, Azam Tariq, Hudebia",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/verify-dist.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "start": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "verify": "node scripts/verify-dist.mjs",
    "postinstall": "node scripts/copy-wasm.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "dexie": "^4.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
